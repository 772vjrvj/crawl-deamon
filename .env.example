DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=service_db
DB_USER=service_user
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10

# 이 실행 인스턴스가 담당할 서비스 코드 하나를 선택한다.
# PANDA_MESSAGE 또는 NAVER_SHOP_TOTAL_DETAIL
DAEMON_SERVICE_CODE=NAVER_SHOP_TOTAL_DETAIL

# PANDA_MESSAGE의 Selenium Chrome 표시 여부입니다.
# true: 창을 띄우지 않음(한 PC 동시 운영 권장), false: Chrome 창 표시
# NAVER_SHOP_TOTAL_DETAIL은 일반 Chrome을 직접 제어하므로 이 값을 사용하지 않습니다.
SELENIUM_HEADLESS=true
